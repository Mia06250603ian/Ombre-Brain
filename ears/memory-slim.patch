+"""声学特征计算器——独立子进程版。
+
+为什么要单独拆一个文件出来跑:
+librosa 的 `yin`(算音高)第一次被调用时会把 numba + llvmlite 拖进内存做即时编译,
+**约 200MB,而且 Python 永远不会把已导入的模块卸载掉**。
+在常驻的 FastAPI 进程里,这意味着「发了第一条语音之后,ears 就永久占着 280MB 不还」。
+
+2026-08-01 实测(在线上容器里):
+    刚启动               34MB
+    算完 yin             242MB     ← 涨的这 200 多 MB 再也不还
+    再算 rms/onset/centroid  不再涨,只要 0.1 秒
+
+而这台 VPS 只有 3.7GB、养着六个服务 + 一个 Chrome,且**平台没给任何容器设内存上限**
+(cgroup memory.max 全是 max),内存耗尽时内核挑「单个最胖的进程」下手——
+实测 ears 这个 Python 进程当时就是全机第一顺位,晏(claude 进程)是第二顺位。
+
+所以把这段算法挪进一次性子进程:**算完进程退出,那 200MB 当场还给系统。**
+
+⚠️ 算法、参数、四舍五入位数与旧版**逐字一致**,输出的数字不变——
+`data/profile.json` 里那 200 条滚动基线继续有效,不需要重新养。改这里时务必保持这一点。
+
+用法:python3 acoustic_worker.py <wav 路径>   → stdout 打印一行 JSON
+"""
+
+import json
+import os
+import sys
+
+# numba 的编译缓存默认落在容器的临时文件系统里,容器一重建就没了,
+# 那样「重启后第一条语音」要等十几秒(实测冷编译 17.6s,有缓存 1.9s)。
+# 指到持久卷上,缓存就能跨重启复用。设在 import librosa 之前才有效。
+os.environ.setdefault("NUMBA_CACHE_DIR", os.environ.get("EARS_NUMBA_CACHE", "/app/data/numba-cache"))
+try:
+    os.makedirs(os.environ["NUMBA_CACHE_DIR"], exist_ok=True)
+except OSError:
+    pass  # 目录建不了就退回默认行为,只是慢一点,不该让语音分析失败
+
+import numpy as np
+
+
+def acoustic_features(wav_path: str) -> dict:
+    import librosa
+    y, sr = librosa.load(wav_path, sr=16000, mono=True)
+    dur = len(y) / sr
+    if dur < 0.3:
+        return {"duration_s": round(dur, 1)}
+    f0 = librosa.yin(y, fmin=60, fmax=500, sr=sr)
+    voiced = f0[(f0 > 60) & (f0 < 500)]
+    rms = librosa.feature.rms(y=y)[0]
+    onset = librosa.onset.onset_strength(y=y, sr=sr)
+    cent = librosa.feature.spectral_centroid(y=y, sr=sr)[0]
+    feats = {
+        "duration_s": round(float(dur), 1),
+        "pitch_hz": round(float(np.mean(voiced)), 1) if len(voiced) else 0.0,
+        "pitch_range": round(float(np.std(voiced)), 1) if len(voiced) else 0.0,
+        "energy": round(float(np.mean(rms)), 4),
+        "energy_sway": round(float(np.std(rms)), 4),          # shimmer的近似：音量起伏
+        "pause_ratio": round(float(np.mean(rms < np.percentile(rms, 20) * 1.5)), 2),
+        "tempo": round(float(np.mean(onset)), 2),
+        "tempo_sway": round(float(np.std(onset)), 2),           # 语速起伏：忽快忽慢
+        "brightness": round(float(np.mean(cent)), 0),          # 频谱质心：音色亮暗
+    }
+    if len(voiced) > 2:
+        # jitter的近似：相邻帧音高抖动
+        feats["pitch_jitter"] = round(float(np.mean(np.abs(np.diff(voiced))) / np.mean(voiced)), 4)
+    return feats
+
+
+if __name__ == "__main__":
+    if len(sys.argv) < 2:
+        print("用法: python3 acoustic_worker.py <wav 路径>", file=sys.stderr)
+        sys.exit(2)
+    # 只把 JSON 写到 stdout;librosa/numba 的警告走 stderr,不会污染结果
+    sys.stdout.write(json.dumps(acoustic_features(sys.argv[1]), ensure_ascii=False))
